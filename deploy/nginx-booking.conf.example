# Install as a NEW vhost file. Replace ONLY booking.example.com and certificate paths.
# Do not replace nginx.conf, remove existing vhosts or attach to the main site.
server {
    listen 80;
    server_name booking.example.com;
    return 301 https://booking.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name booking.example.com;
    ssl_certificate /etc/nginx/ssl/booking.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/booking.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;

    # Do not log URLs, query strings, request bodies, cookies or student data.
    access_log off;
    error_log /var/log/nginx/classroom-error.log warn;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
        proxy_redirect off;
    }
}
