# Copy to .env and chmod 600 .env. Never commit real credentials.
DEBUG=false
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
ALLOWED_HOSTS=booking.example.com
CSRF_TRUSTED_ORIGINS=https://booking.example.com
DB_ENGINE=mysql
DB_HOST=your-private-mysql-host
DB_PORT=3306
DB_NAME=classroom_booking
DB_USER=classroom_app
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# External DB: mount the provider CA into both app containers, then set its path.
# DB_SSL_CA=/run/db-ca/ca.pem
# Dedicated local DB container only: set DB_HOST=db and a separate root password.
# MYSQL_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD
# 45 online + at most 14 backup days = below the 60-day total policy.
RETENTION_DAYS=45
BOOKING_ADVANCE_DAYS=30
BOOKING_MAX_HOURS=4
CANCEL_BEFORE_MINUTES=30
